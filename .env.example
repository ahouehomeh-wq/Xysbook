# ------------------------------------------------------------------
# Configuration XyS Book Mondial
# Copie ce fichier en `.env` puis adapte les valeurs.
#   cp .env.example .env
# ATTENTION : ne jamais commiter le fichier `.env` sur GitHub.
# ------------------------------------------------------------------

# Port du serveur (par défaut 3000)
PORT=3000

# URL de connexion PostgreSQL (voir docker-compose.yml pour la base locale)
DATABASE_URL=postgresql://xys_user:xys_password@localhost:5432/xys_book

# Clé secrète signant les jetons JWT.
# Génère une phrase très longue et difficile à deviner, par ex. :
#   openssl rand -hex 48
JWT_SECRET=change-moi-par-une-tres-longue-phrase-secrete-au-moins-48-caracteres

# Origine autorisée par CORS. '*' autorise tout (démo).
# En production, mets ton vrai domaine, ex : https://ton-domaine.com
CLIENT_ORIGIN=*

# E-mails qui deviennent administrateurs (séparés par des virgules).
# Le compte qui s'inscrit avec cet e-mail obtient le rôle admin.
ADMIN_EMAILS=ton-email-admin@gmail.com

# Environnement : development ou production
# (en production, la connexion PostgreSQL utilise SSL)
NODE_ENV=development
